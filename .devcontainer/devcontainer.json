{
    "name": "Next.js Dev Container",
    "image": "mcr.microsoft.com/devcontainers/javascript-node",
    "customizations": {
        "vscode": {
            "extensions": [
                "bradlc.vscode-tailwindcss"
            ]
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:4": {
            "moby": false
        },
        "ghcr.io/devcontainers-extra/features/mvnd-sdkman:2": {}
    },
    "postStartCommand": "find . -name \"*.sh\" -not -path \"./node_modules/*\" -exec chmod +x {} \\; -exec git update-index --chmod=+x {} \\; && .devcontainer/post-create.sh"
}